{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niko Workbench",
  "version": "2.2.0",
  "identifier": "com.sztzzz7.niko-workbench",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Niko",
        "width": 440,
        "height": 360,
        "minWidth": 280,
        "minHeight": 230,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "chat",
        "title": "和 Niko 聊天",
        "url": "chat.html",
        "width": 380,
        "height": 320,
        "minWidth": 320,
        "minHeight": 260,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "workbench",
        "title": "Niko Workbench",
        "url": "niko-workbench.html",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "agent",
        "title": "Niko Agent",
        "url": "agent.html",
        "width": 1060,
        "height": 740,
        "minWidth": 780,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["browser-extension/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNTgzNEVEMkRDQTUyQgpSV1FycGR6U1RvUEZEZWdRNG1LckRoRnBkb1VzWWhqZ2FuRm45dlZVanFBLzNmV2RpS2R3TXV6RQo=",
      "endpoints": [
        "https://github.com/Ziitaa/Kardii-AI-Companion/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
